generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?
  status     Int?      @default(1) @db.SmallInt
  isActive          Boolean   @default(true)
  isPrivate         Boolean   @default(false)


  approved_at  DateTime?
  availability String?

  email               String?   @unique
  username            String?
  name                String?   @db.VarChar(255)
  first_name          String?   @db.VarChar(255)
  last_name           String?   @db.VarChar(255)
  bio                 String?   @db.VarChar(255)
  password            String?   @db.VarChar(255)
  domain              String?   @unique
  avatar              String? 
  coverPhoto          String?



  google_id   String? @unique
  apple_id     String? @unique

  phone_number  String?
  country       String?
  state         String?
  city          String?
  address       String?
  zip_code      String?
  gender        String?
  date_of_birth DateTime? @db.Date

  subscription_status  String?           @default("inactive")
  subscription         Subscription[]
  subscription_type    SubscriptionType? @default(FREE)
  billing_id           String?
  subscripton_end_date DateTime?

  type               String?   @default("user")
  email_verified_at  DateTime?

  isTwoFactorEnabled Boolean   @default(false)
  twoFactorMethod    String?
  twoFactorCode      String?
  twoFactorExpiresAt DateTime?


  admincontrol admincontrol @default(active)

  is_two_factor_enabled  Int?         @default(0)
  two_factor_secret      String? 
  credit                 Float? 

  user_payment_methods UserPaymentMethod[]
  user_settings        UserSetting[]
  ucodes               Ucode[]
  roles                Role[]
  role_users           RoleUser[]
  payment_transactions PaymentTransaction[]

  NotificationSent     Notification[] @relation("SenderNotifications")
  NotificationReceived Notification[] @relation("ReceiverNotifications")

  carts                Cart[]
  favorites            Favorite[]

  @@map("users")
}

enum admincontrol {
  active
  suspended
}



enum SubscriptionType {
  FREE
  PREMIUM_MONTHLY
  PREMIUM_YEARLY
}
enum Status {
  PENDING
  COMPLETE
  CANCELED
}

model Subscription {
  id                   String            @id @default(cuid())
  user                 User              @relation(fields: [userId], references: [id])
  userId               String            
  paypalSubscriptionId String?           @unique
  stripeSubscriptionId String?           @unique
  appleSubscriptionId  String?           @unique
  googlePaySubscriptionId String?          @unique
  status               Status
  type                 SubscriptionType?
  price                Float?
  customId             String?
  currentPeriodEnd     DateTime
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}









model Ucode {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  status     Int?     @default(1) @db.SmallInt

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  token      String?
  email      String?
  expired_at DateTime?

  @@map("ucodes")
}

model Role {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  status Int?    @default(1) @db.SmallInt
  title  String?
  name   String?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  role_users RoleUser[]
 

  @@map("roles")
}



model RoleUser {
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  role_id String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([role_id, user_id])
  @@map("role_users")
}



enum NotificationType {
  like
  comment
  share
  comment_reply 
  friend_request 
  friend_accept 
  register 
  payment 
  subscription 
}

model Notification {
  id            String           @id @default(cuid())
  receiver_id   String
  sender_id     String
  message       String
  type          NotificationType
  role          String           @default("user")
  status        String           @default("unread")
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  post_id       String
  comment_id    String?
  read          Boolean          @default(false)
  friendship_id String? 
  receiver      User             @relation("ReceiverNotifications", fields: [receiver_id], references: [id])
  sender        User             @relation("SenderNotifications", fields: [sender_id], references: [id])

 

  @@map("notifications")
}

model UserPaymentMethod {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  payment_method_id String?
  checkout_id       String?

  @@map("user_payment_methods")
}

model PaymentTransaction {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  store_id String?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  order_id         String?
  type             String?  @default("order")
  withdraw_via     String?  @default("wallet")
  provider         String?
  reference_number String?
  status           String?  @default("pending")
  raw_status       String?
  amount           Decimal?
  currency         String?
  paid_amount      Decimal?
  paid_currency    String?

  @@map("payment_transactions")
}


enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
}


model Attachment {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  name     String?
  type     String?
  size     Int?
  file     String?
  file_alt String?


  @@map("attachments")
}



model Faq {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  status     Int?    @default(1) @db.SmallInt
  sort_order Int?    @default(0)
  question   String?
  answer     String?

  @@map("faqs")
}
model Contact {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  

  name    String?
  email   String?
  subject String
 
  message String?

  @@map("contacts")
}


model Setting {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  category      String?
  label         String?
  description   String?
  key           String? @unique
  default_value String?

  user_settings UserSetting[]

  @@map("settings")
}

model UserSetting {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  setting_id String?
  setting    Setting? @relation(fields: [setting_id], references: [id])

  value String?

  @@map("user_settings")
}



model GeneralSetting {
  id             String   @id @default(cuid())
  appName        String
  appDescription String
  contactEmail   String
  contactPhone   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}



///////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////// BLOG MODELS STARTS/////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum BlogCategory {
  ALL
  RIDER_SPOTLIGHTS
  SPORT_HIGHLIGHTS
  ON_THE_ROAD
  ARION_WORLD
}

model Blog {
  id                String        @id @default(cuid())
  title             String
  authorName        String
  description       String        @default("")
  thumbnailImageUrl String?
  thumbnailVideoUrl String?
  tags              String[]
  category          BlogCategory
  contentImages     BlogContentImage[]
  status            BlogStatus    @default(DRAFT)
  publishedAt       DateTime?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  clicks            Int           @default(0)
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model BlogContentImage {
  id          String   @id @default(cuid())
  imageUrl    String
  imageTitle  String
  imageDetail String
  imageDescription String

  blogId      String
  blog        Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

///////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////// BLOG MODELS ENDS///////////////////////////////////////////////// 
///////////////////////////////////////////////////////////////////////////////////////////////////////////////


model Job {
  id         String     @id @default(cuid())
  firstName  String
  lastName   String
  email      String
  phone      String
  town       String
  state      String
  experience String
  message    String
  files      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}
model ContactInformation {
  id        String     @id @default(cuid())
  address   String
  facebook  String? @db.VarChar(255)
  instagram String? @db.VarChar(255)
  tiktok    String? @db.VarChar(255)
  youtube   String? @db.VarChar(255)
}


enum type {
  SADDLES
  TACK
}
model Category {
  id           String    @id @default(cuid())
  name          String
  type          type
  subcategories Subcategory[] 
  products      Product[]     
  baseProducts  BaseProduct[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@unique([name, type])
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
  baseProducts BaseProduct[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  //@@unique([name, categoryId]) 
}

// ProductName enum removed; name becomes free-form string, validated in service for SADDLES


model Product {
  id              String    @id @default(cuid())
  name            String
  sku             String      @unique
  stockQuantity   Int
  benefits        String?
  description     String?
  leatherCareGuide String?
  price           Float
  discountPrice   Float?
  color           String?
  size            String?

  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId   String?
  subcategory     Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  carts           CartItem[]
  images          ProductImage[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}


model ProductImage {
  id        String    @id @default(cuid())
  url       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
}



model Cart {
  id        String     @id @default(cuid())
  user                 User              @relation(fields: [userId], references: [id])
  userId               String  
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cart      Cart     @relation(fields: [cartId], references: [id])
  cartId    String

  product   Product  @relation(fields: [productId], references: [id])
  productId String

  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Discpline {
  JUMPING
  DRESSAGE
  CROSS_COUNTRY
}

enum Color {
  BLACK
  LIGHT_BROWN
  DARK_BROWN
}

model CustomerAlert {
  id           String   @id @default(cuid())
  alertId      String   @unique
  priceMin     Float
  priceMax     Float
  brand        String
  discpline    Discpline
  seatsSize         String
  color        Color
  customerFirstName String
  customerLastName String
  customerEmail String
  phoneNumber String
  town String
  state String
  notes String
  createdAt    DateTime @default(now())
}

model Favorite {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  baseProductId String?
  baseProduct   BaseProduct? @relation(fields: [baseProductId], references: [id], onDelete: Cascade)

  saddleProductId String?
  saddleProduct   SaddlesProduct? @relation(fields: [saddleProductId], references: [id], onDelete: Cascade)

  @@unique([userId, baseProductId])
  @@unique([userId, saddleProductId])
  @@map("favorites")
}



//////////////////////////////////////////////////////Base Product Models/////////////////////////////////////////////////
model color {
  id         String   @id @default(cuid())
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Variant Variant[]
}
model size {
  id         String   @id @default(cuid())
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Variant Variant[]
}

model BaseProduct {
  id           String        @id @default(cuid())
  name         String
  sku          String        @unique
  benefits        String?
  description     String?
  leatherCareGuide String?
  variants     Variant[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId   String?
  subcategory     Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  Favorite Favorite[]
}

model Variant {
  id            String        @id @default(cuid())
  BaseproductId     String
  Baseproduct       BaseProduct       @relation(fields: [BaseproductId], references: [id], onDelete: Cascade)

  // FK references to color and size
  colorId       String?
  colorRef      color?         @relation(fields: [colorId], references: [id], onDelete: SetNull)
  sizeId        String?
  sizeRef       size?          @relation(fields: [sizeId], references: [id], onDelete: SetNull)

  // Optional denormalized names for quick reads
  color         String?
  size          String?
  price         Float
  stockQuantity Int
  isDefault     Boolean       @default(false)
  images        VariantImage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([BaseproductId, colorId, sizeId])
  @@index([BaseproductId])
  @@index([colorId])
  @@index([sizeId])
}

model VariantImage {
  id        String   @id @default(cuid())
  url       String
  variantId String
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////Base Product Models End/////////////////////////////////////////////////

model Team {
  id         String   @id @default(cuid())
  name       String
  designation String?
  image      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("teams")
}

model Ambassador {
  id         String   @id @default(cuid())
  name       String
  social_links String?
  image      String?
  country    String?
  flag_image String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("ambassadors")
}

model competition {
  id         String   @id @default(cuid())
  name       String
  location   String
  date       DateTime
  discipline String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("competitions") 
}

model contact_infos{
  id         String   @id @default(cuid())
  address    String
  fb_link    String?
  instagram_link String?
  tiktok_link String?
  youtube_link String?
  updated_at DateTime @updatedAt

  @@map("contact_infos")
}

model contact_us{
  id         String   @id @default(cuid())
  first_name String
  last_name  String
  email      String
  phone      String
  address1   String
  address2   String
  city       String
  state      String
  zip_code   String
  subject    String
  message    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("contact_us")
}

model Expert{
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  country    String?
  region     String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("experts")
}

// ---------------------------------saddles product part starts--------------------------------

enum productcategory {
  SADDLES
  TACK
  LEADLINE
  USED
}

enum saddleSubcategory {
  ATLAS
  ARION
  ATHENA
}



enum tackSubcategory {
  BRIDLES
  REINS
  MARTINGALES
  GRITHSF
  STIRRUP_LEATHERS
  PADS
  RIDER_APPAREL
  BOOTS
  ACCESSORIES
}


model SaddlesProduct {
  id              String    @id @default(cuid())
  name            String
  sku             String      @unique
  header_title    String?
  header_description String?
  price           String
  sizes           String[]
  description     String?
  category        productcategory
  subcategory     saddleSubcategory?
  images          SaddleProductImage[]
  colors              String[]  
  piping_color        String[]      
  leather_type        String[] 

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  Favorite Favorite[]

  @@map("saddles_products")
}

model SaddleProductImage {
  id        String    @id @default(cuid())
  url       String
  saddleproduct   SaddlesProduct @relation(fields: [SaddlesProductId], references: [id], onDelete: Cascade)
  SaddlesProductId String
}

// ---------------------------------saddles product part ends----------------------------------