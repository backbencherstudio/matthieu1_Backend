generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?
  status     Int?      @default(1) @db.SmallInt
  isActive   Boolean   @default(true)
  isPrivate  Boolean   @default(false)

  approved_at  DateTime?
  availability String?

  email      String? @unique
  username   String?
  name       String? @db.VarChar(255)
  first_name String? @db.VarChar(255)
  last_name  String? @db.VarChar(255)
  bio        String? @db.VarChar(255)
  password   String? @db.VarChar(255)
  domain     String? @unique
  avatar     String?
  coverPhoto String?

  google_id String? @unique
  apple_id  String? @unique

  phone_number  String?
  country       String?
  state         String?
  city          String?
  address       String?
  zip_code      String?
  gender        String?
  date_of_birth DateTime? @db.Date

  subscription_status  String?           @default("inactive")
  subscription         Subscription[]
  subscription_type    SubscriptionType? @default(FREE)
  billing_id           String?
  subscripton_end_date DateTime?

  type              String?   @default("user")
  email_verified_at DateTime?

  isTwoFactorEnabled Boolean   @default(false)
  twoFactorMethod    String?
  twoFactorCode      String?
  twoFactorExpiresAt DateTime?

  admincontrol admincontrol @default(active)

  is_two_factor_enabled Int?    @default(0)
  two_factor_secret     String?
  credit                Float?

  user_payment_methods UserPaymentMethod[]
  user_settings        UserSetting[]
  ucodes               Ucode[]
  roles                Role[]
  role_users           RoleUser[]
  payment_transactions PaymentTransaction[]

  NotificationSent     Notification[] @relation("SenderNotifications")
  NotificationReceived Notification[] @relation("ReceiverNotifications")

  carts     Cart[]
  favorites Favorite[]

  @@map("users")
}

enum admincontrol {
  active
  suspended
}

enum SubscriptionType {
  FREE
  PREMIUM_MONTHLY
  PREMIUM_YEARLY
}

enum Status {
  PENDING
  COMPLETE
  CANCELED
}

model Subscription {
  id                      String            @id @default(cuid())
  user                    User              @relation(fields: [userId], references: [id])
  userId                  String
  paypalSubscriptionId    String?           @unique
  stripeSubscriptionId    String?           @unique
  appleSubscriptionId     String?           @unique
  googlePaySubscriptionId String?           @unique
  status                  Status
  type                    SubscriptionType?
  price                   Float?
  customId                String?
  currentPeriodEnd        DateTime
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

model Ucode {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  status     Int?     @default(1) @db.SmallInt

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  token      String?
  email      String?
  expired_at DateTime?

  @@map("ucodes")
}

model Role {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  status Int?    @default(1) @db.SmallInt
  title  String?
  name   String?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  role_users RoleUser[]

  @@map("roles")
}

model RoleUser {
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  role_id String
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  user_id String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([role_id, user_id])
  @@map("role_users")
}

enum NotificationType {
  like
  comment
  share
  comment_reply
  friend_request
  friend_accept
  register
  payment
  subscription
}

model Notification {
  id            String           @id @default(cuid())
  receiver_id   String
  sender_id     String
  message       String
  type          NotificationType
  role          String           @default("user")
  status        String           @default("unread")
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  post_id       String
  comment_id    String?
  read          Boolean          @default(false)
  friendship_id String?
  receiver      User             @relation("ReceiverNotifications", fields: [receiver_id], references: [id])
  sender        User             @relation("SenderNotifications", fields: [sender_id], references: [id])

  @@map("notifications")
}

model UserPaymentMethod {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  payment_method_id String?
  checkout_id       String?

  @@map("user_payment_methods")
}

model PaymentTransaction {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  custom_transaction_id String?  @unique
  store_id              String?
  user_id               String?
  user                  User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  order_id              String?  @unique
  order                 Order?   @relation(fields: [order_id], references: [id], onDelete: SetNull)
  amount                Decimal?
  status                String?  @default("pending")
  type                  String?  @default("order")

  payment_intent_id String?
  client_secret     String?
  payment_method_id String? @default("card")
  payment_gateway   String? @default("stripe")
  withdraw_via      String? @default("wallet")

  provider         String?
  reference_number String?
  raw_status       String?
  currency         String?
  paid_amount      Decimal?
  paid_currency    String?

  @@map("payment_transactions")
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
}

model Attachment {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  name     String?
  type     String?
  size     Int?
  file     String?
  file_alt String?

  @@map("attachments")
}

model Faq {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  status     Int?    @default(1) @db.SmallInt
  sort_order Int?    @default(0)
  question   String?
  answer     String?

  @@map("faqs")
}

model Contact {
  id         String   @id @default(cuid())
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  name    String?
  email   String?
  subject String

  message String?

  @@map("contacts")
}

model Setting {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  category      String?
  label         String?
  description   String?
  key           String? @unique
  default_value String?

  user_settings UserSetting[]

  @@map("settings")
}

model UserSetting {
  id         String    @id @default(cuid())
  created_at DateTime  @default(now())
  updated_at DateTime  @default(now())
  deleted_at DateTime?

  user_id String?
  user    User?   @relation(fields: [user_id], references: [id])

  setting_id String?
  setting    Setting? @relation(fields: [setting_id], references: [id])

  value String?

  @@map("user_settings")
}

model GeneralSetting {
  id             String   @id @default(cuid())
  appName        String
  appDescription String
  contactEmail   String
  contactPhone   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

///////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////// BLOG MODELS STARTS/////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////////

enum Blog_Category {
  RIDER_SPOTLIGHTS
  SPORT_HIGHLIGHTS
  ON_THE_ROAD
  ARION_WORLD
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model Blog {
  id                String             @id @default(cuid())
  title             String
  authorName        String
  thumbnailImageUrl String?
  thumbnailVideoUrl String?
  descriptions      String?
  tags              String[]
  category          Blog_Category
  contentImages     BlogContentImage[]
  status            BlogStatus         @default(DRAFT)
  publishedAt       DateTime?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  clicks            Int                @default(0)
}

model BlogContentImage {
  id               String @id @default(cuid())
  imageUrl         String
  imageTitle       String
  imageDetail      String
  imageDescription String

  blogId     String
  blog       Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

///////////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////// BLOG MODELS ENDS///////////////////////////////////////////////// 
///////////////////////////////////////////////////////////////////////////////////////////////////////////////

model Job {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String
  phone      String
  town       String
  state      String
  experience String
  message    String
  files      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactInformation {
  id        String  @id @default(cuid())
  address   String
  facebook  String? @db.VarChar(255)
  instagram String? @db.VarChar(255)
  tiktok    String? @db.VarChar(255)
  youtube   String? @db.VarChar(255)
}

enum type {
  SADDLES
  TACK
}

model Cart {
  id         String  @id @default(cuid())
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?
  sessionId  String? @unique
  couponCode String?

  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id       String @id @default(cuid())
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId   String
  quantity Int    @default(1)

  // ---- TACK PRODUCT ----
  tackProductId String?
  tackProduct   TackProduct? @relation(fields: [tackProductId], references: [id], onDelete: Cascade)

  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // ---- USED SADDLE ----
  usedSaddleId String?
  usedSaddle   UsedSaddle? @relation(fields: [usedSaddleId], references: [id], onDelete: Cascade)

  // ---- LEADLINE ----
  leadlineId String?
  leadline   SaddlesProduct? @relation(fields: [leadlineId], references: [id], onDelete: Cascade)

  trialPeriod TrialPeriod?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model coupon {
  id             String        @id @default(cuid())
  code           String        @unique
  discount       Float
  expiresAt      DateTime
  // discountType        DiscountType @default(PERCENTAGE)
  // maxDiscount_usd     Float?
  // maxDiscount_eur     Float?
  maxUsers       Int?
  maxUsesPerUser Int?
  usages         couponUsage[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model couponUsage {
  id        String @id @default(cuid())
  userId    String
  couponId  String
  usedCount Int    @default(0)

  coupon coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, couponId])
}

enum Discpline {
  JUMPING
  DRESSAGE
  CROSS_COUNTRY
}

enum Color {
  BLACK
  LIGHT_BROWN
  DARK_BROWN
}

model CustomerAlert {
  id                String    @id @default(cuid())
  alertId           String    @unique
  priceMin          Float
  priceMax          Float
  brand             String
  discpline         Discpline
  seatsSize         String
  color             Color
  customerFirstName String
  customerLastName  String
  customerEmail     String
  phoneNumber       String
  town              String
  state             String
  notes             String
  createdAt         DateTime  @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tackProductId String?
  tackProduct   TackProduct? @relation(fields: [tackProductId], references: [id], onDelete: Cascade)

  saddleProductId String?
  saddleProduct   SaddlesProduct? @relation(fields: [saddleProductId], references: [id], onDelete: Cascade)

  usedSaddleProductId String?
  usedSaddleProduct   UsedSaddle? @relation(fields: [usedSaddleProductId], references: [id], onDelete: Cascade)

  @@unique([userId, tackProductId])
  @@unique([userId, saddleProductId])
  @@unique([userId, usedSaddleProductId])
  @@map("favorites")
}

///////////////////////////////////////////////////// Tack Product Models/////////////////////////////////////////////////

model TackProduct {
  id               String           @id @default(cuid())
  name             String
  sku              String           @unique
  benefits         String?
  description      String?
  leatherCareGuide String?
  thumbnailImage   String?
  country          saddlecountry
  category         productcategory
  subcategory      tackSubcategory?

  variants Variant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Favorite  Favorite[]
  cartItems CartItem[]
}

model Variant {
  id String @id @default(cuid())

  TackProductId String
  Tackproduct   TackProduct @relation(fields: [TackProductId], references: [id], onDelete: Cascade)

  colorId  String?
  colorRef color?  @relation(fields: [colorId], references: [id], onDelete: Cascade)

  sizeId  String?
  sizeRef size?   @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  color String?
  size  String?

  price_usd     Float
  price_eur     Float
  stockQuantity Int

  isDefault Boolean @default(false)

  images VariantImage[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]

  @@unique([TackProductId, colorId, sizeId])
  @@index([TackProductId])
}

model color {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Variant   Variant[]
}

model size {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Variant   Variant[]
}

model VariantImage {
  id        String  @id @default(cuid())
  url       String
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////Base Product Models End/////////////////////////////////////////////////

model Team {
  id          String  @id @default(cuid())
  name        String
  designation String?
  image       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("teams")
}

model Ambassador {
  id           String  @id @default(cuid())
  name         String
  social_links String?
  image        String?
  country      String?
  flag_image   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("ambassadors")
}

model competition {
  id         String   @id @default(cuid())
  name       String
  location   String
  date       DateTime
  discipline String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("competitions")
}

model contact_infos {
  id             String   @id @default(cuid())
  address        String
  fb_link        String?
  instagram_link String?
  tiktok_link    String?
  youtube_link   String?
  updated_at     DateTime @updatedAt

  @@map("contact_infos")
}

model contact_us {
  id         String   @id @default(cuid())
  first_name String
  last_name  String
  email      String
  phone      String
  address    String
  city       String
  state      String
  zip_code   String
  message    String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("contact_us")
}

model Expert {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  country String?
  region  String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("experts")
}

// ---------------------------------saddles product part starts--------------------------------

enum productcategory {
  SADDLES
  TACK
  LEADLINE
  USED
}

enum saddleSubcategory {
  ATLAS
  ARION
  ATHENA
}

enum saddlecountry {
  USA
  EUROPE
}

enum tackSubcategory {
  BRIDLES
  REINS
  MARTINGALES
  GRITHSF
  STIRRUP_LEATHERS
  PADS
  RIDER_APPAREL
  BOOTS
  ACCESSORIES
  HALTERS
  LEATHER_CARE
  OTHER
}

enum saddleSize {
  SIZE_12_5
  SIZE_14_5
}

model SaddlesProduct {
  id                 String               @id @default(cuid())
  name               String
  sku                String               @unique
  header_title       String?
  header_description String?
  price_usd          String
  price_eur          String
  size               saddleSize?
  stockQuantity      Int?
  description        String?
  country            saddlecountry
  category           productcategory
  subcategory        saddleSubcategory?
  images             SaddleProductImage[]
  colors             String[]
  piping_color       String[]
  leather_type       String[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Favorite  Favorite[]
  cartItems CartItem[]

  @@map("saddles_products")
}

model SaddleProductImage {
  id               String         @id @default(cuid())
  url              String
  saddleproduct    SaddlesProduct @relation(fields: [SaddlesProductId], references: [id], onDelete: Cascade)
  SaddlesProductId String
}

// ---------------------------------saddles product part ends----------------------------------

// ---------------------------------user saddles product part start----------------------------------

enum TrialPeriod {
  NO_TRIAL
  TRIAL_7_DAYS
  TRIAL_14_DAYS
}

enum Brand {
  AMERIGO
  ANTARES
  ARION
  BUTET
  CWD
  DEVOUCOUX
  ERREPLUS
  FORSTIER
  HERMES
  MEYER
  N2_SADDLERY
  VOLTAIRE
}

enum SeatSize {
  SIZE_16_5 @map("16.5")
  SIZE_17   @map("17")
  SIZE_17_5 @map("17.5")
  SIZE_18   @map("18")
  SIZE_18_5 @map("18.5")
}

model UsedSaddle {
  id                 String          @id @default(cuid())
  sku                String          @unique
  title              String
  description        String
  seatSize           SeatSize
  stockQuantity      Int
  category           productcategory
  usedsaddlecategory String
  discipline         Discpline
  brand              Brand
  basePrice_usd      Int
  basePrice_eur      Int
  country            saddlecountry
  isAvailable        Boolean         @default(true)

  images    UsedSaddleImage[]
  favorites Favorite[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cartItems CartItem[]
}

model UsedSaddleImage {
  id           String     @id @default(cuid())
  url          String
  usedsaddle   UsedSaddle @relation(fields: [UsedSaddleId], references: [id], onDelete: Cascade)
  UsedSaddleId String
}

